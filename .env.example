APP_NAME=Office Maintenance
# Signs the session cookie. Replace with a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The placeholder below is never used as-is: the app falls back to a random
# per-process secret (sessions reset on restart) and logs a warning.
SECRET_KEY=YOUR_SECRET_KEY_HERE
DATABASE_URL=sqlite:///./maintenance.db
# true behind HTTPS: Secure session cookie + HSTS header
SESSION_HTTPS_ONLY=false
UPLOAD_DIR=./uploads
# Password of the demo people seeded into a fresh database
DEMO_PASSWORD=OfficeDemo1!
# PBKDF2 work factor for new password hashes (default 600000; only lower it for tests)
# PASSWORD_HASH_ITERATIONS=600000
# Largest accepted request body in bytes (default 6 MB = 5 MB photo + form fields)
# MAX_REQUEST_BYTES=6291456
